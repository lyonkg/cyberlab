{
  "name": "cyberlab",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "server": "node server/index.mjs",
    "server:test": "node --test server/validate.test.mjs",
    "dev:all": "node scripts/dev-all.mjs",
    "test:all": "vitest run && node --test server/validate.test.mjs",
    "build:mac": "node scripts/build-mac.mjs",
    "smoke:webkit": "node scripts/webkit-smoke.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.69.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "oxlint": "^1.90.0",
    "tailwindcss": "^4.3.4",
    "typescript": "~5.9.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
