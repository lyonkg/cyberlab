# Lab backend mode: "simulated" (default) or "real"
# simulated = all labs run client-side, no API keys required
# real = frontend calls the local lab API (npm run server)
VITE_LAB_MODE=simulated

# Base URL of the local lab API (loopback HTTP allowed; elsewhere must be https://)
VITE_LAB_API_URL=http://127.0.0.1:8787

# Build-time deployment settings — read from the SHELL environment by vite.config.ts
# (not from this file), e.g.  VITE_BASE=/cyberlab/ npm run build
# VITE_BASE=/          # "/cyberlab/" for GitHub Pages project sites, "./" for the Mac zip
# VITE_ROUTER=browser  # "hash" forces HashRouter (automatic when VITE_BASE=./)
